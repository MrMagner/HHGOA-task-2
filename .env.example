# ============================================
# Voice-RAG System Environment Configuration
# ============================================
# Copy this to .env and fill in your API keys

# --- Application ---
APP_NAME=Voice-RAG
APP_VERSION=1.0.0
DEBUG=false
DEMO_MODE=false
LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- STT Provider (sarvam / elevenlabs / demo) ---
STT_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai/speech-to-text-translate
SARVAM_LANGUAGE=hi-IN
ELEVENLABS_API_KEY=
ELEVENLABS_API_URL=https://api.elevenlabs.io/v1/speech-to-text

# --- LLM Provider (groq / openai / demo) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DEVICE=cpu

# --- Vector DB (Qdrant) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=msmarco_xi
QDRANT_LOCAL_PATH=./qdrant_data

# --- Retrieval ---
RETRIEVAL_TOP_K=10
RETRIEVAL_DENSE_WEIGHT=0.6
RETRIEVAL_BM25_WEIGHT=0.4
CONTEXT_TOP_K=5
MIN_RELEVANCE_SCORE=0.3

# --- Reranking ---
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=5

# --- Chunking (fixed / sentence / metadata_aware) ---
CHUNKING_STRATEGY=sentence
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_CHUNKS_PER_DOC=20

# --- Guardrails ---
GROUNDING_THRESHOLD=0.5
SAFETY_ENABLED=true
OFFTOPIC_THRESHOLD=0.25

# --- Audio ---
MAX_AUDIO_SIZE_MB=25
ALLOWED_AUDIO_FORMATS=wav,mp3,webm,ogg,m4a,flac

# --- Caching ---
ENABLE_QUERY_CACHE=true
QUERY_CACHE_TTL=3600
ENABLE_EMBEDDING_CACHE=true

# --- Rate Limiting ---
RATE_LIMIT_RPM=60

# --- Dataset ---
DATASET_NAME=ai4bharat/MSMARCO-XI
DATASET_SPLIT=train
DATASET_LANGUAGE=en
DATASET_MAX_SAMPLES=10000
DATA_DIR=./data

# --- Benchmark ---
BENCHMARK_QUERIES=50
